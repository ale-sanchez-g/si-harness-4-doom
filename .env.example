# Copy to .env and adjust. Every value shown is the default.

# --- Model: pick a size ------------------------------------------------------
# Three presets to compare the harness across model sizes. Each one picks the model
# and the playbook that suits it (measured on a 4-core CPU, no GPU; see README):
#
#   xs  granite4:350m-h  IBM Granite 4.0 H 350M  340M params  playbook small    ~2 s/decision   eval 18/22
#   s   granite4:1b-h    IBM Granite 4.0 H 1B    1.5B params  playbook small    ~7 s/decision   eval 22/22
#   m   granite4.2:3b    IBM Granite 4.2 3B      3.7B params  playbook default  ~15 s/decision  eval 21/22
#
# Compare all three on the same games:  make compare   (or: make compare ARGS="--eval")
HARNESS_PRESET=m

# Or name any Ollama model yourself (overrides the preset's model; keep the preset
# closest in size so the matching playbook is used, or set HARNESS_PLAYBOOK too):
# OLLAMA_MODEL=qwen3:4b
# Where the harness finds Ollama (only change for a host/remote Ollama)
# HARNESS_OLLAMA_HOST=http://ollama:11434

# --- What to play -------------------------------------------------------------
# freedoom2 | freedoom1 | doom2 | doom | basic | defend_the_center | defend_the_line |
# deadly_corridor | health_gathering | health_gathering_supreme | my_way_home |
# take_cover | predict_position
HARNESS_SCENARIO=freedoom2
HARNESS_MAP=MAP01
HARNESS_EPISODES=3
HARNESS_MAX_STEPS=400
# 1 (I'm too young to die) .. 5 (Nightmare); empty = server default (3)
HARNESS_SKILL=
# Continue with the next map after finishing a level
HARNESS_CAMPAIGN=true

# --- The harness around the model ---------------------------------------------
# llm = the model decides; scripted = hand-written baseline (no model needed)
HARNESS_POLICY=llm
# Playbook file in harness/playbooks/ (without .md). Empty = the preset's choice:
# "small" for xs and s, "default" for m.
# HARNESS_PLAYBOOK=default
HARNESS_TEMPERATURE=0.2
# Ask for a one-sentence "thought" before each action (slower, more readable)
HARNESS_REASONING=true
HARNESS_NUM_CTX=8192

# --- Observability ---------------------------------------------------------------
# Every run writes runs/<run>/traces.jsonl: one span per run, episode, turn, game
# command and LLM call, with the full prompt, the response, token counts and timings.
# Summarise runs with `make report` (or `python -m doom_harness report runs/A runs/B`).
HARNESS_TRACE=true
# Also export the traces over OpenTelemetry (OTLP/HTTP). `make observe` starts the
# Arize Phoenix UI at http://localhost:6006 and sets this for you:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://phoenix:6006
# PHOENIX_PORT=6006

# --- Game server ---------------------------------------------------------------
DOOM_PORT=8000
DOOM_SKILL=3
# 35 = real-time playback in the viewer, 0 = as fast as possible (benchmarks)
DOOM_PLAYBACK_FPS=35
# fair = the exit/switches are known once seen; full = whole map known from the start
DOOM_KNOWLEDGE=fair
# Report nearby monsters that are out of sight (like hearing them). 0 = off
DOOM_HEARING_RANGE=0
DOOM_RESOLUTION=640x480
